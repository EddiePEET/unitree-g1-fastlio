* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.launch text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.msg text eol=lf
*.srv text eol=lf

*.pcd binary
*.pgm binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.a binary
*.so binary
*.so.* binary

# Required vendor libraries are stored with Git LFS.
third_party/unitree_sdk2_native/lib/aarch64/libunitree_sdk2.a filter=lfs diff=lfs merge=lfs -text
third_party/unitree_sdk2_native/lib/x86_64/libunitree_sdk2.a filter=lfs diff=lfs merge=lfs -text
